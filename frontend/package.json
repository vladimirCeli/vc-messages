    "@capacitor/status-bar": "^8.0.4",
    "@tanstack/react-query": "^5.104.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
